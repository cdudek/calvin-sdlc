{
  "name": "heydiff-web",
  "private": true,
  "description": "HeyDiff: web app, landing, operator area, API and MCP",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H localhost",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --target=node24 --format=cjs --tsconfig=tsconfig.json --out-extension:.js=.cjs --outdir=dist",
    "db:migrate": "npm run build:migrate && node dist/migrate.cjs",
    "db:seed": "esbuild scripts/seed.ts --bundle --platform=node --target=node24 --format=cjs --tsconfig=tsconfig.json --out-extension:.js=.cjs --outdir=dist && node dist/seed.cjs",
    "db:measure": "esbuild scripts/measure.ts --bundle --platform=node --target=node24 --format=cjs --tsconfig=tsconfig.json --out-extension:.js=.cjs --outdir=dist && node dist/measure.cjs",
    "test": "vitest run",
    "smoke:background": "playwright test",
    "sdlc:tools": "curl -fsSL https://plannotator.ai/install.sh | bash && claude plugin marketplace add backnotprop/plannotator && claude plugin install plannotator@plannotator && npx skills add backnotprop/plannotator/apps/skills/extra --global --skill plannotator-setup-goal --agent claude-code --yes"
  },
  "author": "Calvin Dudek",
  "repository": "github:pokbytes/heydiff-web",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "type": "module",
  "dependencies": {
    "@better-auth/mcp": "1.7.14",
    "@google-cloud/storage": "8.4.0",
    "@pokbytes/heydiff-contracts": "0.0.0-main-20261029091427",
    "@pokbytes/heydiff-tokens": "0.0.0-main-20261029091427",
    "@pokbytes/heydiff-ui": "0.0.0-main-20261029091427",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.35.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
