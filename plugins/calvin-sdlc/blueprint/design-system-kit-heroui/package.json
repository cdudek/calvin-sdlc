{
  "name": "heydiff-kit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "description": "HeyDiff shared packages",
  "repository": "github:pokbytes/heydiff-kit",
  "author": "Calvin Dudek",
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke:background": "echo 'heydiff-kit has no E2E: packages are covered by unit tests'",
    "changeset": "changeset",
    "release:snapshot": "changeset version --snapshot m1 && changeset publish --tag next --no-git-tag",
    "sdlc:tools": "curl -fsSL https://plannotator.ai/install.sh | bash && claude plugin marketplace add backnotprop/plannotator && claude plugin install plannotator@plannotator"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
