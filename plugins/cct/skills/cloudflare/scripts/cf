#!/usr/bin/env bash
# Calls the Cloudflare API (or wrangler) with the token exported in ~/.zshrc. The token never reaches stdout or stderr.
#   cf GET /zones                              API call; "{account}" in the path becomes CLOUDFLARE_ACCOUNT_ID
#   cf POST /zones/ZONE/dns_records '{"..."}'  JSON body as the third argument, or "@file.json"
#   cf wrangler <args>                         runs npx wrangler with the token and account in its env
set -euo pipefail

# Interactive zsh sources ~/.zshrc; its banner goes to /dev/null, only the value comes back on fd 3.
zshvar() { zsh -ic "print -rn -- \"\$$1\" >&3" 3>&1 >/dev/null 2>&1; }

export CLOUDFLARE_API_TOKEN="${CLOUDFLARE_API_TOKEN:-$(zshvar CLOUDFLARE_API_TOKEN)}"
export CLOUDFLARE_ACCOUNT_ID="${CLOUDFLARE_ACCOUNT_ID:-$(zshvar CLOUDFLARE_ACCOUNT_ID)}"

if [[ -z "$CLOUDFLARE_API_TOKEN" || -z "$CLOUDFLARE_ACCOUNT_ID" ]]; then
  echo "cloudflare skill: CLOUDFLARE_API_TOKEN or CLOUDFLARE_ACCOUNT_ID is not exported in ~/.zshrc" >&2
  exit 1
fi

if [[ "${1:-}" == wrangler ]]; then
  shift
  exec npx --yes wrangler "$@"
fi

if [[ $# -lt 2 ]]; then
  echo "usage: cf METHOD /path [json-body|@file] | cf wrangler <args>" >&2
  exit 2
fi

method=$1 path=${2//\{account\}/$CLOUDFLARE_ACCOUNT_ID} body=${3:-}
args=(-sS -X "$method" "https://api.cloudflare.com/client/v4$path" -H "Content-Type: application/json")
[[ -n "$body" ]] && args+=(--data "$body")
# The header comes from a here-string, so the token is never on the command line (ps) or in an error message.
exec curl "${args[@]}" -H @- <<<"Authorization: Bearer $CLOUDFLARE_API_TOKEN"
