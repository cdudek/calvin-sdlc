#!/usr/bin/env bash
# Usage: aws <aws cli args>   — the AWS CLI with the user's credentials
# Purpose: run the AWS CLI without the keys ever reaching stdout, stderr or the process list.
# Output: the AWS CLI's own output.
# Credentials, in order: the standard env vars or AWS_PROFILE / ~/.aws (SSO included); else AWS_ACCESS_KEY and
# AWS_SECRET_ACCESS_KEY exported in the user's zsh profile (its banner goes to /dev/null, only the value comes back on fd 3).
set -euo pipefail

zshvar() { command -v zsh >/dev/null 2>&1 && zsh -ic "print -rn -- \"\$$1\" >&3" 3>&1 >/dev/null 2>&1 || true; }

if [[ -z "${AWS_ACCESS_KEY_ID:-}" && -z "${AWS_PROFILE:-}" && ! -f "$HOME/.aws/credentials" && ! -f "$HOME/.aws/config" ]]; then
  export AWS_ACCESS_KEY_ID="$(zshvar AWS_ACCESS_KEY)"
  export AWS_SECRET_ACCESS_KEY="$(zshvar AWS_SECRET_ACCESS_KEY)"
  if [[ -z "$AWS_ACCESS_KEY_ID" || -z "$AWS_SECRET_ACCESS_KEY" ]]; then
    echo "aws-manage: no AWS credentials (env, AWS_PROFILE, ~/.aws, or AWS_ACCESS_KEY/AWS_SECRET_ACCESS_KEY in ~/.zshrc)" >&2
    exit 1
  fi
fi
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-${AWS_REGION:-eu-central-1}}"

exec command aws "$@"
