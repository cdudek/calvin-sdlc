{
  "name": "heydiff-chrome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HeyDiff: the Chrome extension",
  "repository": "github:pokbytes/heydiff-chrome",
  "author": "Calvin Dudek",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke:background": "npm run e2e",
    "sdlc:tools": "curl -fsSL https://plannotator.ai/install.sh | bash && claude plugin marketplace add backnotprop/plannotator && claude plugin install plannotator@plannotator",
    "e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@pokbytes/heydiff-contracts": "0.0.0-milestone-online-release-1-1-20261029072513",
    "@pokbytes/heydiff-tokens": "0.0.0-milestone-online-release-1-1-20261029072513",
    "@pokbytes/heydiff-ui": "0.0.0-milestone-online-release-1-1-20261029072513",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  }
}
